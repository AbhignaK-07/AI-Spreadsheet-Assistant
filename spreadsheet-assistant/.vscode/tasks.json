{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (FastAPI)",
      "type": "shell",
      "command": "uvicorn main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true
    },
    {
      "label": "Start Frontend (Vite + React)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true
    },
    {
      "label": "Start Full Stack",
      "dependsOn": ["Start Backend (FastAPI)", "Start Frontend (Vite + React)"]
    }
  ]
}
